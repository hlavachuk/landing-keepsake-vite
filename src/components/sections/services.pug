section#about.section.container
  h2.section-title= 'What do we do'
  p.section-intro= 'We are a small team of designers and makers who help brands look their best online and offline.'
  .services
    each service in services
      article
        .service-icon
          +icon(service.icon)
        h3= service.title
        p= service.description
  dl.stats
    each stat in stats
      div
        dt= stat.label
        dd= stat.value
